{
  "name": "anti-slop-gleam",
  "version": "0.1.0",
  "private": true,
  "description": "Oxlint rules that restrict TypeScript to a small, Gleam-like dialect for coding agents.",
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm check:skill && pnpm check:conventions",
    "lint": "oxlint --format default src",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "check:conventions": "node scripts/check-conventions.mjs"
  },
  "dependencies": {
    "@oxlint/plugins": "1.78.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT"
}
